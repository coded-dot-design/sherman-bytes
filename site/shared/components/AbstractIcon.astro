---
const { kind = 'ship', size = 48 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" class="character-icon">
  {kind === 'ship' && <><path d="M14 2h4v6h4v6h4v10h-8v-4h-4v4H6V14h4V8h4V2Z" fill="currentColor"/><path d="M14 10h4v8h-4z" fill="var(--surface)"/><path d="M10 26h4v4h-4zm8 0h4v4h-4z" fill="currentColor" opacity=".9"/></>}
  {kind === 'runner' && <g transform="translate(2 2) scale(2)" shape-rendering="crispEdges"><path d="M4 0h6v1h2v2h2v1h-2v1h-2v1H8v2h2v1h2v1h2v1h-2v2h-2v1H4v-1H2v-2H1V9H0V5h1V3h1V1h2Z" fill="#cdde00"/><path d="M5 2h2v2H5Z" fill="#222e56"/></g>}
  {kind === 'bug' && <><path d="M10 8h12v16H10z" fill="currentColor"/><path d="m12 8-4-5m12 5 4-5M10 12 4 9m6 8H2m8 4-6 5m18-14 6-3m-6 8h8m-8 4 6 5" stroke="currentColor" stroke-width="2"/><path d="M15 10h2v12h-2z" fill="var(--surface)"/></>}
  {kind === 'tank' && <><path d="M3 5h26v7H3zm0 16h26v7H3z" fill="currentColor" opacity="1"/><path d="M7 9h17v15H7z" fill="currentColor"/><path d="M12 12h10v9H12z" fill="var(--surface)"/><path d="M19 15h13v3H19z" fill="currentColor"/></>}
  {kind === 'ghost' && <g transform="translate(2 2) scale(2)" shape-rendering="crispEdges"><path d="M4 0h6v1h2v2h1v2h1v9h-2v-2h-2v2H8v-2H6v2H4v-2H2v2H0V5h1V3h1V1h2Z" fill="currentColor"/><path d="M2 4h4v5H2zm6 0h4v5H8Z" fill="#fff4ff"/><path d="M4 5h2v3H4zm6 0h2v3h-2Z" fill="#222e56"/></g>}
</svg>
