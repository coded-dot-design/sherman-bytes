{
  "name": "@coded-design/sherman-bytes",
  "version": "1.0.0",
  "type": "module",
  "description": "Sherman Bytes: Bolo-inspired tank combat across the DOM. By Chris Cooley / coded.design.",
  "license": "MIT",
  "author": "Chris Cooley",
  "sideEffects": [
    "./site-kit/**",
    "./site/**"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/coded-dot-design/sherman-bytes.git"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --expose-gc --import tsx --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package && node scripts/vendor-check.mjs",
    "playground:build": "vite build --config vite.config.js",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit",
    "test:package": "tsc -p tsconfig.package.json",
    "dev:playground": "vite --config vite.config.js",
    "test:browser": "node tests/browser.mjs",
    "sync": "node scripts/sync.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
