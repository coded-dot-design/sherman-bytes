{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": false,
    "paths": {
      "@coded-design/dom-virus": [
        "./shared/types/index.d.ts"
      ],
      "@coded-design/dom-virus/react": [
        "./shared/types/react.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/types.test.ts"
  ]
}
